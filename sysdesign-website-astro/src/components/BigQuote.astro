---
interface Props {
  attribution?: string;
}
const { attribution } = Astro.props;
---
<aside class="big-quote my-10 not-prose">
  <div class="relative pl-12 pr-4">
    <span aria-hidden="true" class="absolute left-0 top-0 text-7xl leading-none font-serif text-[color:var(--color-accent)] opacity-50 select-none">“</span>
    <div class="text-xl sm:text-2xl font-medium text-[color:var(--color-text)] leading-snug tracking-tight">
      <slot />
    </div>
    {attribution && <div class="mt-3 text-sm text-[color:var(--color-text-muted)]">— {attribution}</div>}
  </div>
</aside>
